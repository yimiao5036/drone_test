{
    "log": {
        "dir": "logs/",
        "level": "info"
    },
    "runtime": {
        "enable_video": true,
        "enable_px4": true,
        "enable_ground_station": true,
        "enable_control": false
    },
    "mavlink": {
        "onboard_system_id": 1,
        "onboard_component_id": 191
    },
    "px4": {
        "transport": "serial",
        "firmware_version": "1.17.0",
        "target_system_id": 1,
        "target_component_id": 1,
        "mavlink_version": 2,
        "heartbeat_send_interval_ms": 1000,
        "heartbeat_timeout_ms": 3000,
        "telemetry_timeout_ms": 2000,
        "state_publish_interval_ms": 100,
        "command_ack_timeout_ms": 1000,
        "setpoint_send_interval_ms": 50,
        "setpoint_timeout_ms": 500,
        "setpoint_queue_capacity": 4,
        "command_queue_capacity": 16,
        "one_shot_message_requests": [148, 242],
        "message_interval_requests": [
            {"message_id": 1, "interval_us": 1000000},
            {"message_id": 24, "interval_us": 200000},
            {"message_id": 30, "interval_us": 100000},
            {"message_id": 32, "interval_us": 100000},
            {"message_id": 33, "interval_us": 200000},
            {"message_id": 65, "interval_us": 200000},
            {"message_id": 147, "interval_us": 1000000},
            {"message_id": 245, "interval_us": 500000}
        ],
        "serial": {
            "device": "/dev/ttyS1",
            "baud_rate": 115200,
            "data_bits": 8,
            "stop_bits": 1,
            "parity": "N",
            "read_timeout_ms": 20,
            "write_timeout_ms": 100
        },
        "udp": {
            "bind_address": "127.0.0.1",
            "bind_port": 14540,
            "remote_address": "127.0.0.1",
            "remote_port": 14580,
            "read_timeout_ms": 20,
            "write_timeout_ms": 100
        },
        "reconnect_interval_ms": 1000
    },
    "ground_station": {
        "mavlink_version": 2,
        "heartbeat_send_interval_ms": 1000,
        "heartbeat_timeout_ms": 3000,
        "flight_state_queue_capacity": 2,
        "send_interval_ms": {
            "attitude": 100,
            "local_position": 200,
            "global_position": 200,
            "gps": 500,
            "extended_state": 500,
            "system_status": 1000,
            "battery": 1000,
            "home": 5000
        },
        "serial": {
            "device": "/dev/ttyS6",
            "baud_rate": 115200,
            "data_bits": 8,
            "stop_bits": 1,
            "parity": "N",
            "read_timeout_ms": 20,
            "write_timeout_ms": 100
        }
    },
    "yolo": {
        "model_path": "models/yolo26n-drone.rknn",
        "conf_threshold": 0.60,
        "nms_threshold": 0.45,
        "max_detection_frame_lag": 10,
        "class_names": [
            "BALLOON"
        ]
    },
    "video": {
        "input_rtsp": "rtsp://192.168.144.25:8554/main.264",
        "output_rtsp": "rtsp://127.0.0.1:8554/drone_out",
        "width": 1280,
        "height": 720,
        "fps": 25,
        "bitrate": 6000000
    }
}
